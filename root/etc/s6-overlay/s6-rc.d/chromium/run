#!/command/with-contenv sh
export HOME=/home/user
export DISPLAY=${DISPLAY:-:99}

# Which browser to launch. Default: google-chrome-stable. `switch-browser`
# writes chrome|cloak to this file and restarts this service, so the same CDP
# endpoint (:9221) is served by whichever browser is active — browser-trace and
# cdp-proxy are unaffected.
# Precedence: the state file (written by `switch-browser` for mid-session swaps) wins when present;
# otherwise the ACTIVE_BROWSER env var (set at sandbox-create time) selects the browser on first
# boot, so a fresh sandbox can start straight into Cloak without a post-start swap; default chrome.
STATE_FILE=/home/user/.active-browser
ACTIVE=$(cat "$STATE_FILE" 2>/dev/null || echo "${ACTIVE_BROWSER:-chrome}")

# Flags shared by both browsers. Both use the same profile dir and route through
# tinyproxy (:8119), so the residential-proxy / egress-IP flow is identical
# regardless of which browser is active.
# --window-position/--window-size force full-screen directly.
# --force-device-scale-factor matches the popular desktop scaling (125%).
# --window-size is adjusted to account for 1920x1080 scaled down by 125%.
COMMON="--start-maximized --window-position=0,0 --window-size=1536,864 \
--no-sandbox --no-first-run --disable-default-apps \
--force-device-scale-factor=1.25 \
--no-default-browser-check --remote-debugging-port=9221 --disable-dev-shm-usage \
--disable-features=OptimizationGuideModelDownloading,OptimizationHints,OptimizationTargetPrediction \
--disable-background-networking --disable-component-update --disable-domain-reliability \
--disable-sync --no-pings --enable-logging=stderr --log-level=3 \
--user-data-dir=/home/user/chrome-profile --proxy-server=http://127.0.0.1:8119"

if [ "$ACTIVE" = "cloak" ] && ! command -v cloak-browser >/dev/null 2>&1; then
  echo "chromium: CloakBrowser not installed (amd64 only) — falling back to Chrome" >&2
  ACTIVE=chrome
fi

if [ "$ACTIVE" = "custom" ] && ! command -v custom-chrome >/dev/null 2>&1; then
  echo "chromium: custom-chrome not installed — falling back to Chrome" >&2
  ACTIVE=chrome
fi

if [ "$ACTIVE" = "cloak" ]; then
  exec s6-setuidgid user cloak-browser $COMMON \
    --fingerprint-platform=windows \
    --use-gl=swiftshader \
    about:blank
elif [ "$ACTIVE" = "custom" ]; then
  # No --disable-gpu/--disable-software-rasterizer here: unlike google-chrome-stable,
  # this build needs a GL context under Xvfb or getContext('webgl') returns null.
  exec s6-setuidgid user custom-chrome $COMMON \
    --enable-unsafe-swiftshader \
    about:blank
else
  exec s6-setuidgid user google-chrome-stable $COMMON \
    --disable-gpu \
    --disable-software-rasterizer \
    about:blank
fi
