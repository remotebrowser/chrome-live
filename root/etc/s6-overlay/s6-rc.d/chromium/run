#!/command/with-contenv sh
export HOME=/home/user
export DISPLAY=${DISPLAY:-:99}

# Which browser to launch. Default: google-chrome-stable. `switch-browser`
# writes chrome|cloak to this file and restarts this service, so the same CDP
# endpoint (:9221) is served by whichever browser is active — browser-trace and
# cdp-proxy are unaffected.
STATE_FILE=/home/user/.active-browser
ACTIVE=$(cat "$STATE_FILE" 2>/dev/null || echo chrome)

# Flags shared by both browsers.
COMMON="--start-maximized --no-sandbox --no-first-run --disable-default-apps \
--no-default-browser-check --remote-debugging-port=9221 --disable-dev-shm-usage \
--disable-features=OptimizationGuideModelDownloading,OptimizationHints,OptimizationTargetPrediction \
--disable-background-networking --disable-component-update --disable-domain-reliability \
--disable-sync --no-pings --enable-logging=stderr --log-level=3"

if [ "$ACTIVE" = "cloak" ] && ! command -v cloak-browser >/dev/null 2>&1; then
  echo "chromium: CloakBrowser not installed (amd64 only) — falling back to Chrome" >&2
  ACTIVE=chrome
fi

if [ "$ACTIVE" = "cloak" ]; then
  exec s6-setuidgid user cloak-browser $COMMON \
    --fingerprint-platform=windows \
    --use-gl=swiftshader \
    --user-data-dir=/home/user/cloak-profile \
    about:blank
else
  exec s6-setuidgid user google-chrome-stable $COMMON \
    --disable-gpu \
    --disable-software-rasterizer \
    --user-data-dir=/home/user/chrome-profile \
    --proxy-server=http://127.0.0.1:8119 \
    about:blank
fi
