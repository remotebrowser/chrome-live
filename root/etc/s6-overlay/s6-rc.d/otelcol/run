#!/command/with-contenv sh

# OpenTelemetry Collector sidecar (see /etc/otelcol/config.yaml). Opt-in: when
# disabled we idle instead of exiting so browser-trace / tinyproxy-log can
# keep a static dependency on this service.
if [ "${OTEL_COLLECTOR_ENABLED:-false}" != "true" ]; then
  exec sleep infinity
fi

export LOGFIRE_BASE_URL="${LOGFIRE_BASE_URL:-https://logfire-us.pydantic.dev}"
export GOMEMLIMIT="${GOMEMLIMIT:-320MiB}"

set -- --config=/etc/otelcol/config.yaml
if [ -n "${OTEL_SECONDARY_ENDPOINT:-}" ]; then
  export OTEL_SECONDARY_AUTHORIZATION="${OTEL_SECONDARY_AUTHORIZATION:-}"
  set -- "$@" --config=/etc/otelcol/secondary.yaml
fi

exec /usr/local/bin/otelcol "$@"
